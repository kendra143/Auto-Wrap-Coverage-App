{
  "expo": {
    "name": "Auto Wrap Coverage",
    "slug": "auto-wrap-coverage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autowrapcoverage.app"
    },
    "android": {
