      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "website": "https://www.autowrapcoverage.com/"
    }
  }
}
